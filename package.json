{
  "name": "tg-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "poll": "node scripts/poller.ts",
    "mock": "node scripts/mock-telegram.ts",
    "e2e": "node scripts/e2e.ts",
    "test": "node --test scripts/test-schedule.ts",
    "bench:vtb": "node scripts/bench-vtb.ts",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 migrations apply users --local",
    "db:init:remote": "wrangler d1 migrations apply users --remote"
  },
  "dependencies": {
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "esbuild": "0.28.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
